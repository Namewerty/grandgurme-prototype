{
  "name": "grandgurme-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Интерактивный прототип главной страницы «№1 Гранд Гурмэ». Направление «Перламутр и жесть».",
  "scripts": {
    "pages": "node scripts/build-pages.mjs",
    "media": "node scripts/media-list.mjs",
    "predev": "node scripts/build-pages.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-pages.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "postbuild": "node scripts/after-build.mjs",
    "bitrix:data": "node scripts/build-bitrix-data.mjs",
    "bitrix": "node scripts/build-bitrix-data.mjs && vite build --config vite.bitrix.config.js",
    "stand": "npm run bitrix && node scripts/stand-pack.mjs",
    "stand:drift": "node scripts/stand-ssh.mjs drift",
    "stand:deploy": "node scripts/stand-ssh.mjs deploy",
    "stand:pull": "node scripts/stand-ssh.mjs pull",
    "stand:php": "node scripts/stand-ssh.mjs php"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.3.11"
  },
  "devDependencies": {
    "vite": "^7.1.9"
  }
}
