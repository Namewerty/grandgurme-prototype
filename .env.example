# Образец переменных окружения прототипа. Скопировать в .env.local
# (он в .gitignore) и заполнить; на Vercel — Settings → Environment Variables.

# Ключ HTTP-геокодера Яндекса («HTTP Геокодер» в кабинете разработчика
# developer.tech.yandex.ru). С ним оформление и адреса кабинета определяют
# зону доставки по адресу (src/js/checkout/zones.js). Пусто — зону выбирают
# из списка, рядом карта зон. Ключ из бандла боевого сайта не брать: он
# выдан под JS API Карт и домен заказчика.
VITE_YANDEX_GEOCODER_KEY=
