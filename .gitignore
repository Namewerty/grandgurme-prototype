# Зависимости и сборка — ставятся и собираются командой, в репозитории им делать нечего.
node_modules
dist
.vite
*.log
.DS_Store
Thumbs.db

# Привязка папки к проекту Vercel. Содержит id проекта и команды, делиться им не нужно.
.vercel

# Настройки локального запуска: абсолютные пути к node на этой машине,
# на другой машине бесполезны.
.claude

# Снимки экрана для обсуждения с заказчиком — 20 МБ, на сайте не используются.
screenshots

# Присланные заказчиком макеты и черновик дизайн-кода. Сборщик их не видит
# (findPages в vite.config.js берёт только index.html), на сайт не попадают.
Фильтры.html
grandgurme-homepage-mockup(2).html
design-code.html

# Каркасы внутренних страниц. Их заново пишет scripts/build-pages.mjs по
# src/data/routes.js перед каждым npm run dev/build (predev/prebuild), правки
# в них затираются. В репозитории лежит источник — карта сайта и генератор.
# Исключения — две написанные руками страницы: главная и черновая /alt.
/**/index.html
!/index.html
!/alt/index.html
