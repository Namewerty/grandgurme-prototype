+  padding: .35rem .35rem .35rem 1.1rem;
+  border: 1px solid var(--hairline);
+  border-radius: var(--radius-pill);
+  transition: border-color var(--dur-line) var(--ease-out);
+}
+
+.search-page__form:focus-within { border-color: var(--caspian); }
+
+.search-page__icon {
